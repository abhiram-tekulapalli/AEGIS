# AI_PROVIDER: Central AI Provider selection ('gemini')
AI_PROVIDER=gemini

# GEMINI_API_KEY: Required for Google Gemini Developer API inference calls.
# Obtain a free-tier API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model identifier for Google Gemini Developer API (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# AI Inference Execution Configuration
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_MAX_CONCURRENT_REQUESTS=2
AI_MAX_OUTPUT_TOKENS=4096

# APP_URL: Self-referential URL where this applet is hosted
APP_URL="MY_APP_URL"
